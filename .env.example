# Backend environment variables. Copy to `.env` (git-ignored) and fill in real values locally.
# Names only: never commit real values. Staging/production load these from the host's secret store, not a file.
# NOTE: Spec 16.4 places the canonical .env.example in `peoplehub-infra`. This file is tentative until the
# docker-compose location decision (CLAUDE.md section 15, issue 1) is made.
#
# Local development without any of this: `./mvnw spring-boot:test-run` starts throwaway Postgres and Redis
# containers via Testcontainers and needs no environment variables.

# --- PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/peoplehub
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- Sentry (Spec 14.2) ---
# Leave SENTRY_DSN empty to disable Sentry entirely: nothing is sent. Events are scrubbed of personal data before
# they leave the process (see SentryEventScrubber).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# --- Logging (Spec 14.1) ---
# Logs are JSON at INFO by default. Override the level per environment; never ship DEBUG to production.
# `SPRING_PROFILES_ACTIVE=local` gives readable console output and DEBUG for our own code: developer machines only.
LOGGING_LEVEL_ROOT=INFO
SPRING_PROFILES_ACTIVE=

# --- Shutdown (Spec 16.4) ---
# How long in-flight requests get to finish on shutdown (and, separately, running jobs: see below). [confirm] 30s is an
# unconfirmed default. Shutdown can take up to twice this plus the 5s job unwind period (65s), so the orchestrator's
# stop grace period must be 90s or more, not merely above this value.
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# --- Scheduled jobs (Spec 2, 14.3) --- all [confirm]: unconfirmed defaults, not approved values
# A running job gets the same shutdown timeout as above (SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE), then is
# interrupted. The web server and the scheduler stop one after another: a single slow request, or a single slow job, is
# bounded by its own 30s, but both together can take twice that (60s with the default), plus the unwind time below
# (65s in total): the orchestrator's stop grace period must be 90s or more.
# SPRING_TASK_SCHEDULING_SHUTDOWN_AWAIT_TERMINATION must stay false (see application.yml).
# Not a second wait for the job to finish: the time an INTERRUPTED job gets to finish unwinding (releasing its lock)
# before the database closes. With 0 the lock can stay held until lockAtMostFor.
SPRING_TASK_SCHEDULING_SHUTDOWN_AWAIT_TERMINATION_PERIOD=5s
# Threads that run jobs (Spring's own default is 1, so one slow job would delay all the others).
SPRING_TASK_SCHEDULING_POOL_SIZE=4
# How long a job's lock is held if its instance dies mid-run, unless the job sets its own (ISO-8601). Must exceed the
# longest job that uses the default.
PEOPLEHUB_SCHEDULING_DEFAULT_LOCK_AT_MOST_FOR=PT10M
