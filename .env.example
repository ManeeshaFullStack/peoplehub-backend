# Backend environment variables. Copy to `.env` (git-ignored) and fill in real values locally.
# Names only: never commit real values. Staging/production load these from the host's secret store, not a file.
# NOTE: this is the template for the BACKEND development stack (docker-compose.yml in this repository). The complete
# platform stack, with its own .env.example, moves to infrastructure ownership (`peoplehub-infra`) when the frontend
# exists (CLAUDE.md, B0-7 decisions).
#
# Three ways to run, each needing different parts of this file:
#  1. `./mvnw spring-boot:test-run`: throwaway Postgres and Redis via Testcontainers; needs NO environment variables.
#  2. `docker compose up --build --wait`: the containerised stack; needs the "Docker Compose" section below. Compose
#     reads `.env` for its own settings and builds the container's connection settings itself, so it does not use the
#     localhost URLs further down.
#  3. `./mvnw spring-boot:run` against your own Postgres/Redis: needs the sections after "Docker Compose".

# --- Docker Compose (docker-compose.yml) ---
# The four secrets have NO defaults on purpose: Compose refuses to start until each is set. Make them long and random
# (for example `openssl rand -hex 24`); use different values, and never reuse a real password. Keep them out of git.
# PostgreSQL bootstrap superuser: lives only inside the db container, used once to create the two roles below.
POSTGRES_BOOTSTRAP_PASSWORD=
# Migration/owner role and runtime role (the same roles as in the next section, provisioned for you by the stack).
PEOPLEHUB_DB_OWNER_PASSWORD=
PEOPLEHUB_DB_RUNTIME_PASSWORD=
REDIS_PASSWORD=
# Not secret; the defaults below apply when these are unset or empty. The bootstrap user must not start with `pg_`; the
# role names follow [a-z_][a-z0-9_]{0,62}. Changing a role name or password later does not touch an existing volume
# (the roles are created once): use ALTER ROLE, or `docker compose down -v` to start from scratch (destroys dev data).
# POSTGRES_BOOTSTRAP_USER=pgbootstrap
# PEOPLEHUB_DB_NAME=peoplehub
# PEOPLEHUB_DB_OWNER_ROLE=peoplehub_owner
# Host ports, bound to 127.0.0.1 only. PostgreSQL and Redis are NOT published at all: put a docker-compose.override.yml
# (git-ignored) next to docker-compose.yml if you need them from the host.
# PEOPLEHUB_BACKEND_PORT=8080
# PEOPLEHUB_MAILPIT_UI_PORT=18025
# Also used by the stack: SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE, LOGGING_LEVEL_ROOT, SENTRY_DSN, SENTRY_ENVIRONMENT
# and PEOPLEHUB_DB_RUNTIME_ROLE (all defined further down). The backend's stop grace period is fixed at 90s in the compose
# file (see the Shutdown section below).

# --- PostgreSQL: two roles (Spec 15; CLAUDE.md section 9; README, "Database roles") ---
# The application runs as the least-privileged RUNTIME role. It can never UPDATE or DELETE the audit log.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/peoplehub
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Migrations run as a separate OWNER role (not a superuser). Without these, Flyway would use the runtime credentials
# above and fail to create tables. SPRING_FLYWAY_URL is only needed when the runtime URL cannot run migrations (for
# example a connection pooler); by default Flyway uses SPRING_DATASOURCE_URL.
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=
# SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/peoplehub   (leave commented out unless needed: an empty value is not "unset")
# Name of the runtime role, which the migrations grant privileges to. It must match SPRING_DATASOURCE_USERNAME's role
# and must already exist: Flyway never creates roles, so infrastructure provisions both roles before the first start.
# Lower-case letters, digits and underscores only ([a-z_][a-z0-9_]{0,62}); anything else stops startup.
PEOPLEHUB_DB_RUNTIME_ROLE=peoplehub_app

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- Email (Spec 9.2, b1-2) ---
# Plain SMTP via Spring's JavaMailSender. Host/port default to Mailpit's usual local port even when
# unset, so nothing here is required for ./mvnw spring-boot:test-run. For production (Brevo's SMTP
# relay, or any other SMTP provider), set host/port/username/password and enable STARTTLS -- the
# same SmtpEmailSender code path either way, no provider-specific configuration or code.
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# REQUIRED to actually send (no default): the sender identity for every outgoing email (Spec 9.2,
# "clear sender identity"). Sending fails (a safe, logged CONFIGURATION_ERROR, not a crash) while
# this is unset; the application itself still starts.
PEOPLEHUB_EMAIL_FROM_ADDRESS=
# All [confirm]: unconfirmed defaults, not approved values. See application.yml (peoplehub.email.*)
# for what each one does.
# PEOPLEHUB_EMAIL_RETRY_DELAYS=PT1M,PT5M

# REQUIRED for the bounce/complaint webhook (POST /api/v1/webhooks/email/events, b1-4) to accept
# anything (no default): the shared HMAC-SHA256 secret verified against the X-Webhook-Signature
# header. Every request is rejected as unauthorized while this is unset; the application itself
# still starts. No provider SDK: whichever SMTP/ESP provider is eventually chosen just needs
# configuring to sign its webhook calls with this same secret.
PEOPLEHUB_EMAIL_WEBHOOK_SECRET=

# --- Sentry (Spec 14.2) ---
# Leave SENTRY_DSN empty to disable Sentry entirely: nothing is sent. Events are scrubbed of personal data before
# they leave the process (see SentryEventScrubber).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# --- Logging (Spec 14.1) ---
# Logs are JSON at INFO by default. Override the level per environment; never ship DEBUG to production.
# `SPRING_PROFILES_ACTIVE=local` gives readable console output and DEBUG for our own code: developer machines only.
LOGGING_LEVEL_ROOT=INFO
SPRING_PROFILES_ACTIVE=

# --- Shutdown (Spec 16.4) ---
# How long in-flight requests get to finish on shutdown (and, separately, running jobs: see below). [confirm] 30s is an
# unconfirmed default. Shutdown can take up to twice this plus the 5s job unwind period (65s), so the orchestrator's
# stop grace period must be 90s or more, not merely above this value. docker-compose.yml fixes the backend's
# `stop_grace_period` at 90s; if you raise this value, raise that too (docker/smoke.sh fails when it is below
# 2 x this value + 5s + a margin).
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# --- Scheduled jobs (Spec 2, 14.3) --- all [confirm]: unconfirmed defaults, not approved values
# A running job gets the same shutdown timeout as above (SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE), then is
# interrupted. The web server and the scheduler stop one after another: a single slow request, or a single slow job, is
# bounded by its own 30s, but both together can take twice that (60s with the default), plus the unwind time below
# (65s in total): the orchestrator's stop grace period must be 90s or more.
# SPRING_TASK_SCHEDULING_SHUTDOWN_AWAIT_TERMINATION must stay false (see application.yml).
# Not a second wait for the job to finish: the time an INTERRUPTED job gets to finish unwinding (releasing its lock)
# before the database closes. With 0 the lock can stay held until lockAtMostFor.
SPRING_TASK_SCHEDULING_SHUTDOWN_AWAIT_TERMINATION_PERIOD=5s
# Threads that run jobs (Spring's own default is 1, so one slow job would delay all the others).
SPRING_TASK_SCHEDULING_POOL_SIZE=4
# How long a job's lock is held if its instance dies mid-run, unless the job sets its own (ISO-8601). Must exceed the
# longest job that uses the default.
PEOPLEHUB_SCHEDULING_DEFAULT_LOCK_AT_MOST_FOR=PT10M
