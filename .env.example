# Backend environment variables. Copy to `.env` (git-ignored) and fill in real values locally.
# Names only: never commit real values. Staging/production load these from the host's secret store, not a file.
# NOTE: Spec 16.4 places the canonical .env.example in `peoplehub-infra`. This file is tentative until the
# docker-compose location decision (CLAUDE.md section 15, issue 1) is made.
#
# Local development without any of this: `./mvnw spring-boot:test-run` starts throwaway Postgres and Redis
# containers via Testcontainers and needs no environment variables.

# --- PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/peoplehub
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
